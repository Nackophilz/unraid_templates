<?xml version="1.0"?>
<Container version="2">
  <Name>joal</Name>
  <Repository>digrouz/joal:latest</Repository>
  <Registry>https://hub.docker.com/r/digrouz/joal</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Nackophilz/unraid_templates/issues</Support>
  <Project>https://github.com/anthonyraymond/joal</Project>
  <ReadMe>https://github.com/digrouz/docker-joal#readme</ReadMe>
  <Overview>JOAL is an open-source ratio master with a web UI. It is not designed to help or encourage downloading illegal content: you must respect the law of your country.&#xD;
&#xD;
WebUI: http://IP:PORT/PATH_PREFIX/ui/ (default path prefix: joaleeS8efie). On first connection, enter the same host, port, path prefix and secret token in the UI settings.</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:3965]/joaleeS8efie/ui/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Nackophilz/unraid_templates/main/joal/joal.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/anthonyraymond/joal-desktop/master/resources/icons/1024x1024.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="3965" Default="3965" Mode="tcp" Description="WebUI port (must match JOAL_PORT)" Type="Port" Display="always" Required="true" Mask="false">3965</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/joal" Mode="rw" Description="Configuration, clients and torrents" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/joal</Config>
  <Config Name="Path prefix" Target="JOAL_SECRET_OBFUSCATION_PATH" Default="joaleeS8efie" Mode="" Description="WebUI URL path, alphanumeric only. If changed, update the WebUI link in advanced view." Type="Variable" Display="always" Required="true" Mask="false">joaleeS8efie</Config>
  <Config Name="Secret token" Target="JOAL_SECRET_TOKEN" Default="" Mode="" Description="WebUI password, choose a long random string" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TZ" Target="TZ" Default="Europe/Paris" Mode="" Description="Timezone" Type="Variable" Display="always" Required="false" Mask="false">Europe/Paris</Config>
  <Config Name="JOAL_PORT" Target="JOAL_PORT" Default="3965" Mode="" Description="Internal listen port (must match WebUI Port container port)" Type="Variable" Display="advanced" Required="true" Mask="false">3965</Config>
  <Config Name="PUID" Target="UID" Default="99" Mode="" Description="User ID (Unraid: 99)" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="GID" Default="100" Mode="" Description="Group ID (Unraid: 100)" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="AUTOUPGRADE" Target="AUTOUPGRADE" Default="0" Mode="" Description="Update OS packages at startup (0 or 1)" Type="Variable" Display="advanced" Required="false" Mask="false">0</Config>
</Container>
